                  "const b = pm.response.json();",
                  "pm.test('Sinh duoc mau slot', () => {",
                  "  pm.expect(b.data).to.have.property('timeSlots');",
                  "  pm.expect(b.data.timeSlots.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
