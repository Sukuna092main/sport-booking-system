    {
      "name": "4. Availability phản ánh thay đổi",
      "item": [
        {
          "name": "Availability / Slot 10:00 bị chặn bởi blackout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Availability 200', () => pm.response.to.have.status(200));",
                  "const slots = pm.response.json().data.slots;",
                  "const at10 = slots.filter(s => new Date(s.startsAt).getUTCHours() === 3);",
                  "pm.test('Co slot 10:00 gio VN', () => pm.expect(at10.length).to.be.greaterThan(0));",
                  "pm.test('Slot 10:00 phai available=false', () => {",
                  "  at10.forEach(s => pm.expect(s.available, s.startsAt).to.eql(false));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{baseUrl}}/courts/{{courtId}}/availability?date={{date1}}",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "{{courtId}}", "availability"],
              "query": [{ "key": "date", "value": "{{date1}}" }]
            }
          }
        },
        {
          "name": "Blackout / Ngừng kích hoạt",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Xoa mem blackout 204', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/admin/courts/{{courtId}}/blackouts/{{blackoutId}}", "host": ["{{baseUrl}}"], "path": ["admin", "courts", "{{courtId}}", "blackouts", "{{blackoutId}}"] }
          }
        },
        {
          "name": "Availability / Slot 10:00 available trở lại",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Availability 200', () => pm.response.to.have.status(200));",
                  "const slots = pm.response.json().data.slots;",
                  "const at10 = slots.filter(s => new Date(s.startsAt).getUTCHours() === 3);",
                  "pm.test('Slot 10:00 phai available=true sau khi bo blackout', () => {",
                  "  pm.expect(at10.length).to.be.greaterThan(0);",
                  "  at10.forEach(s => pm.expect(s.available, s.startsAt).to.eql(true));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{baseUrl}}/courts/{{courtId}}/availability?date={{date1}}",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "{{courtId}}", "availability"],
              "query": [{ "key": "date", "value": "{{date1}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "5. Confirmed booking không bị xoá",
      "item": [
        {
          "name": "Booking / Tạo booking để kiểm tra bảo vệ",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Lay slot 08:00 gio VN (01:00Z) de dat.",
                  "const url = pm.variables.replaceIn('{{baseUrl}}/courts/{{courtId}}/availability?date={{date1}}');",
                  "pm.sendRequest({ url: url, method: 'GET' }, (err, res) => {",
                  "  if (err) { return; }",
                  "  const slots = res.json().data.slots;",
                  "  const s8 = slots.filter(s => new Date(s.startsAt).getUTCHours() === 1 && s.available);",
                  "  if (s8.length) { pm.collectionVariables.set('slotId', s8[0].id); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tao booking 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', b.data.id);",
                  "pm.test('Booking CONFIRMED', () => pm.expect(b.data.status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "qa-s4-{{runId}}-booking" }
            ],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courtId\": \"{{courtId}}\",\n  \"bookingDate\": \"{{date1}}\",\n  \"timeSlotIds\": [\"{{slotId}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Court / Ngừng kích hoạt sân",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Xoa mem court 204', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/admin/courts/{{courtId}}", "host": ["{{baseUrl}}"], "path": ["admin", "courts", "{{courtId}}"] }
          }
        },
        {
          "name": "Booking / Vẫn CONFIRMED sau khi sân bị ngừng",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Van xem duoc booking 200', () => pm.response.to.have.status(200));",
                  "pm.test('Booking van CONFIRMED, khong bi xoa', () => {",
                  "  pm.expect(pm.response.json().data.status).to.eql('CONFIRMED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Court / Sân inactive không nhận booking mới",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('San inactive phai tu choi booking moi', () => {",
                  "  pm.expect([409, 422]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "qa-s4-{{runId}}-inactive" }
            ],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courtId\": \"{{courtId}}\",\n  \"bookingDate\": \"{{date1}}\",\n  \"timeSlotIds\": [\"{{slotId}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        }
      ]
    }
  ]
}
