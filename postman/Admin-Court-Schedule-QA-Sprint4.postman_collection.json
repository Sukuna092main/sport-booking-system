          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/courts", "host": ["{{baseUrl}}"], "path": ["admin", "courts"] }
          }
        },
        {
          "name": "Role / ADMIN xem danh sách",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ADMIN xem duoc 200', () => pm.response.to.have.status(200));",
                  "pm.test('Co data va meta', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.data).to.be.an('array');",
                  "  pm.expect(b.meta).to.have.property('total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/admin/courts", "host": ["{{baseUrl}}"], "path": ["admin", "courts"] }
          }
        }
      ]
    },
