{
  "info": {
    "_postman_id": "1ed3ffa7-5c33-4fc7-9563-108a59420fd6",
    "name": "Sport Booking — UAT Sprint 6 (UAT-01..10)",
    "description": "Bộ kịch bản kiểm thử nghiệm thu UAT-01 đến UAT-10 cho Sprint 6 trên môi trường Staging trực tuyến.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sport-booking-api-staging.onrender.com/api/v1",
      "type": "string"
    },
    {
      "key": "targetDate",
      "value": "2026-11-22",
