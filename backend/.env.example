# Use the root .env.example to generate the root .env with:
#   .\scripts\dev\Initialize-LocalEnv.ps1
# Never commit .env or put real credentials in this sample.

APP_NAME=sport-booking-api
APP_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh
HTTP_ADDR=:8080
LOG_LEVEL=info
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Local Docker PostgreSQL. The initializer fills a random password.
POSTGRES_USER=sport
POSTGRES_PASSWORD=
POSTGRES_DB=sport_booking

# Used by Start-BackendNeon.ps1. For Docker Compose, DATABASE_URL is replaced
# with the local Postgres service URL. For Neon, enter your authorized URL here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m
DB_CONN_MAX_IDLE_TIME=5m

# The initializer fills JWT_SECRET with 32 random bytes.
JWT_SECRET=
JWT_TTL=15m
REFRESH_TOKEN_TTL=168h
PASSWORD_RESET_TTL=15m
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
FRONTEND_PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local/demo payment defaults to mock and off. To use VNPAY, set PAYMENT_ENABLED=true,
# PAYMENT_PROVIDER=vnpay, enter credentials from your own merchant account, and set
# both callback URLs to your real, publicly reachable HTTPS API domain.
# 3000 = provisional 30% deposit; an ADMIN must configure each court's price.
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=mock
PAYMENT_DEPOSIT_BPS=3000
PAYMENT_HOLD_TTL=10m
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=

# Email is off by default. To enable sending, set both flags true and provide SMTP
# details issued by your mail provider. The initializer creates the encryption key.
EMAIL_ENABLED=false
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_POLL_INTERVAL=30s
EMAIL_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Frontend Docker build-time setting.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional for backend integration tests only. Use a separate database whose name
# ends in _test; never point tests at Neon or a shared/production database.
TEST_DATABASE_URL=
