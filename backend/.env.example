# Đưa các giá trị này vào shell hoặc trình quản lý môi trường cục bộ.
# Ứng dụng đọc biến môi trường trực tiếp, không tự nạp file .env.
APP_NAME=sport-booking-api
APP_ENV=development
# Dùng múi giờ IANA thật của địa điểm (ví dụ Asia/Ho_Chi_Minh) trước khi xử lý đặt sân.
APP_TIMEZONE=Asia/Ho_Chi_Minh
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

# Tạo secret ngẫu nhiên riêng cho mỗi môi trường (>=32 byte); không commit giá trị thật.
JWT_SECRET=
JWT_TTL=15m

# PostgreSQL — Neon (Direct connection, không dùng URL có -pooler hoặc port 6543)
# Lấy từ Neon Console > Connection Details > Connection string
DATABASE_URL=postgresql://neondb_owner:**********@ep-long-grass-b33vny8t.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Go Connection Pool — giới hạn connection và dọn stale connection khi Neon auto-suspend
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m
DB_CONN_MAX_IDLE_TIME=5m

# Origins FE được phép gọi API từ trình duyệt, phân cách bằng dấu phẩy.
# Development mặc định localhost/127.0.0.1:5173 nếu biến chưa được đặt.
# Test/production mặc định đóng CORS; chuỗi rỗng cũng đóng CORS.
# Online: dùng origin HTTPS thật được Duy bàn giao; không dùng wildcard hoặc /api/v1.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
