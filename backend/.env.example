# Đưa các giá trị này vào shell hoặc trình quản lý môi trường cục bộ.
# Ứng dụng đọc biến môi trường trực tiếp, không tự nạp file .env.
APP_NAME=sport-booking-api
APP_ENV=development
# UTC chỉ dùng để chạy thử skeleton; thay bằng múi giờ IANA thật của địa điểm trước khi xử lý đặt sân.
APP_TIMEZONE=UTC
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
